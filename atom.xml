  <entry>
    <title>Cloud Computing - AgenticFS</title>
    <link href="https://blog.zhongmingmao.top/2026/08/03/cloud-computing-agenticfs/"/>
    <id>https://blog.zhongmingmao.top/2026/08/03/cloud-computing-agenticfs/</id>
